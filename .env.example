VITE_APP_NAME=Enterprise Admin

# 后端监听
HOST=0.0.0.0
PORT=1102
WORKER_THREADS=2

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=antd_admin
DB_TLS=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false

# JWT（生产请改成强随机串）
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-separate-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
